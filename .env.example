# Copy this file to .env and fill in your values
NODE_ENV=development
PORT=3003

DEPLOY_MODE=docker

# Host that a deployed container's dynamically-allocated port is reachable at
# from wherever this process runs. Leave as localhost when the orchestrator
# runs directly on the Docker host; set to host.docker.internal when the
# orchestrator itself runs in a container talking to the host's Docker socket.
DEPLOY_HOST=localhost

HEALTHCHECK_TIMEOUT_MS=30000
HEALTHCHECK_INTERVAL_MS=1000
